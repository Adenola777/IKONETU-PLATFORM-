# Copy to apps/web/.env.local and fill in. Never commit real values.
# Real keys live only in the Vercel and Supabase secret stores (SRD SEC-I1).

# Supabase project URL and the public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Used by API routes, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for links in emails and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
