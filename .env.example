# The app in service/ reads these from its environment when it starts. For a local run, copy
# this file to service/.env, fill it in, and load it before starting the app, as service/README.md
# shows. Never commit real values. Real keys live only in the Render and Supabase dashboards
# (SRD SEC-I1). docs/HOSTING.md lists where each one is entered. The names keep the NEXT_PUBLIC_
# prefix of the Next.js app this one replaced, so the values entered on Render keep working.

# Supabase project URL and the publishable key (sb_publishable_...). Both are
# safe in the browser. Sign-in needs both and answers "not open yet" without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. Used by the waitlist endpoint and to record a founder's score after their own
# statement, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# How many proxies stand in front of the app. The waitlist's rate limit reads the
# caller's address that many entries from the end of X-Forwarded-For. 1 unless set.
# CLIENT_IP_HEADER names a single header set by the edge instead, if there is one.
TRUSTED_PROXY_HOPS=
CLIENT_IP_HEADER=

# Error tracking. Sentry stays off until SENTRY_DSN is set. Server-only.
# docs/OPERATIONS.md says what to do before setting it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Public site URL, used in the sign-in email link and in page metadata.
# It must be a full address with https://, and Supabase Auth must list
# <this address>/auth/callback under Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phone sign-in by WhatsApp or SMS. Leave unset until an SMS and WhatsApp
# provider is set up in Supabase Auth, then set to "on".
NEXT_PUBLIC_PHONE_SIGN_IN=
